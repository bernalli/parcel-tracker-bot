# parcel-tracker-bot configuration. Copy to .env and fill in the two required values.
# Every variable below is read by the bot; anything else in this file is ignored.

# ─── Telegram (REQUIRED) ───────────────────────────────────────────
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID (send /whoami to the bot, or ask @userinfobot).
# The owner is always an admin and can authorise other users.
OWNER_ID=

# Extra users, comma-separated. Admins can also authorise users from the bot menu.
ALLOWED_USER_IDS=
# Extra admins (manage users, statistics, tracker health), comma-separated.
ADMIN_USER_IDS=

# ─── Tracking sources ──────────────────────────────────────────────
# 17track: one API covering 2,000+ carriers worldwide. Strongly recommended:
# it is the fallback whenever a built-in scraper cannot read a carrier page.
# https://api.17track.net — the free plan includes a monthly tracking quota.
TRACK17_API_KEY=

# Official DHL Shipment Tracking API (DHL Express, DHL Paket, eCommerce).
# https://developer.dhl.com — free plan: 250 calls/day, ~1 call per 5 s.
DHL_API_KEY=
# RATE_LIMIT_TRACKER_DHL_API=10

# ─── Polling ───────────────────────────────────────────────────────
# How often the scheduler wakes up (minutes). Each parcel is then checked at
# the interval of its status (below), so keep this at or below the smallest one.
CHECK_INTERVAL_MINUTES=5

# Per-status polling interval in minutes (0 = stop polling). Defaults:
#   STATUS_INTERVAL_NOT_FOUND=60
#   STATUS_INTERVAL_INFO_RECEIVED=60
#   STATUS_INTERVAL_PICKUP=30
#   STATUS_INTERVAL_IN_TRANSIT=15
#   STATUS_INTERVAL_OUT_FOR_DELIVERY=5
#   STATUS_INTERVAL_CUSTOMS=30
#   STATUS_INTERVAL_DELIVERED=0
#   STATUS_INTERVAL_UNDELIVERED=30
#   STATUS_INTERVAL_EXCEPTION=30
#   STATUS_INTERVAL_RETURNED=60
#   STATUS_INTERVAL_EXPIRED=0
#   STATUS_INTERVAL_ALERT=30

# Active parcels per user (0 = unlimited). Raise it for a shop; mind your
# 17track / DHL quotas.
MAX_ACTIVE_SHIPMENTS=20

# Warn when an active shipment has had no carrier update for this many days
# (0 = never). One alert per stall.
STALL_ALERT_DAYS=7

# Parallel checks per batch, and the per-carrier rate limit (requests/minute).
BATCH_SIZE=10
RATE_LIMIT_DEFAULT_PER_MIN=10
# Per-tracker override: RATE_LIMIT_TRACKER_<NAME>=<int>, e.g.
# RATE_LIMIT_TRACKER_TRACK17=30

# HTTP timeout for carrier requests and map tiles (seconds).
REQUEST_TIMEOUT=30

# Tracker health: quarantine a failing carrier for N hours after 3 / 6 / 12
# consecutive failures (the carrier-wide circuit needs four times as many).
QUARANTINE_3FAIL_HOURS=1
QUARANTINE_6FAIL_HOURS=6
QUARANTINE_12FAIL_HOURS=24

# ─── Web dashboard (optional) ──────────────────────────────────────
# A private web view of your shipments, plus a public tracking page you can
# share with each customer. Log in by sending /web to the bot.
WEB_ENABLED=false
# Inside Docker keep 0.0.0.0 and publish the port in docker-compose.yml.
WEB_BIND_HOST=0.0.0.0
WEB_PORT=8080
# The address you open in the browser; links sent by the bot point here.
# Use https behind a reverse proxy when the dashboard is reachable from outside.
WEB_PUBLIC_URL=http://localhost:8080
WEB_SESSION_DAYS=30

# ─── Maps ──────────────────────────────────────────────────────────
# Route maps on notifications. Offline geocoder; tiles from any XYZ server.
MAPS_ENABLED=true
# OSM_TILE_URL=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}@2x.png
# MAP_TILE_SIZE=512

# ─── Language ──────────────────────────────────────────────────────
# Default UI language (en, it). Each user can switch with /lang.
DEFAULT_LANGUAGE=en

# ─── Privacy ───────────────────────────────────────────────────────
# Removed/archived parcels and their history are deleted after this many days
# without changes (0 keeps them forever). /forgetme erases a user at any time.
DATA_RETENTION_DAYS=180

# ─── Storage & logging ─────────────────────────────────────────────
DATABASE_PATH=/app/data/bot.db
LOG_LEVEL=INFO
# 'json' for production, 'console' for local development.
LOG_FORMAT=json
# Tracking codes are hashed in logs unless this is true.
LOG_FULL_TRACKING_ID=false

# ─── Metrics ───────────────────────────────────────────────────────
METRICS_ENABLED=true
# Use 127.0.0.1 to keep the Prometheus endpoint local.
METRICS_BIND_HOST=0.0.0.0
METRICS_PORT=9090
